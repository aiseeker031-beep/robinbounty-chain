# By default the app is on Robinhood Chain testnet (46630).
NEXT_PUBLIC_NETWORK=testnet
# Add the address printed by `npm run deploy:testnet` when your deployment succeeds.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Set a private provider URL for higher reliability if you have one.
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
# Put this ONLY in your local machine/secret manager, never in Vercel or Git:
# DEPLOYER_PRIVATE_KEY=
# For audited mainnet deployment, also ALLOW_MAINNET_DEPLOY=yes
